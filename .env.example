# Google Sheets API Configuration
# Create a Google Cloud project and enable Sheets API
# Get API key from Google Cloud Console
REACT_APP_GOOGLE_SHEETS_API_KEY=your_api_key_here
REACT_APP_GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# Cloudinary Configuration (for image uploads)
# Sign up at cloudinary.com and get your credentials
REACT_APP_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
REACT_APP_CLOUDINARY_UPLOAD_PRESET=your_upload_preset_here
